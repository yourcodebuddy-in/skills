# Copy to .env for local development. Production keeps its .env in /srv/boxoffice/shared.
NODE_ENV=development
PORT=3000
DATABASE_PATH=./data/boxoffice.db
PUBLIC_URL=http://localhost:3000
CURRENCY=EUR

# Payment provider. Test keys start with pk_test_.
PAYMENTS_URL=http://localhost:4010
PAYMENTS_API_KEY=
PAYMENTS_WEBHOOK_SECRET=

# log, file or http
MAIL_TRANSPORT=log
MAIL_FROM=Box Office <tickets@localhost>
MAIL_DIR=./data/mail
MAIL_API_URL=
MAIL_API_KEY=

LOG_LEVEL=info
