PORT=3000
DATABASE_PATH=./data/notes.db
PUBLIC_URL=http://localhost:3000
SESSION_DAYS=14
# Browsers drop Secure cookies over plain http, so turn this off for local work only.
COOKIE_SECURE=false

# "log" prints each email to stdout. "http" posts it to MAIL_API_URL.
MAIL_TRANSPORT=log
MAIL_API_URL=
MAIL_API_KEY=
MAIL_FROM=Tenant Notes <notes@localhost>
